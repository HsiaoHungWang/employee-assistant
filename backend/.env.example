# 複製成 .env 後填入；.env 不要上傳到 Git
MODAONE_API_KEY=請貼上你的金鑰
# 以下為選填
# MODAONE_TOOL_MODEL=gemma-4-31B-it
# MODAONE_API_BASE=https://modaone-llm-api.dginfra.gov.tw/api/v1
# STREAM=1        # 0 = 不串流（除錯用）
# MAX_STEPS=6
# MAX_TURNS=8
# SESSION_TOKEN_BUDGET=60000   # 每個登入工作階段的 token 上限（課堂示範可設 3000）
# SESSION_MAX_CALLS=40
